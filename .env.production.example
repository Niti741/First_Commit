# ==============================================================================
# KIFAYAT AI — PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
PROJECT_NAME="Kifayat AI"
APP_ID=assistant
APPLICATION_VERSION=2.5.0

# Database & Data File Paths (relative to app root or absolute)
SQLITE_DB_PATH=backend/kifayat.db
HANDBOOK_PATH=backend/data/handbook.md
SEED_EXEMPLARS_PATH=backend/data/seed_exemplars.json

# Provider & LLM Configuration
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-your-actual-nvidia-api-key-here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

CHEAP_MODEL_ID=meta/llama-3.2-11b-vision-instruct
STRONG_MODEL_ID=meta/llama-3.1-70b-instruct
JUDGE_MODEL_ID=meta/llama-3.2-11b-vision-instruct

# Streaming & Token Limits
STREAMING_ENABLED=true
MAX_OUTPUT_TOKENS=2048
MAX_QUESTION_LENGTH=4000

# Semantic Cache & Memory
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.90
SEMANTIC_CACHE_TTL=86400
SEMANTIC_CACHE_MAX_ENTRIES=10000

COMPACTION_ENABLED=true
COMPACTION_QUEUE_TYPE=local
RAW_WINDOW_TURNS=3
BLOCK_TURNS=6
BLOCKS_PER_MERGE=5
MAX_MEMORY_TOKENS=4000

# Exemplars Store & Active Learning
MAX_EXEMPLARS=500
EXEMPLAR_MIN_EVALUATIONS=5
EXEMPLAR_STALE_DAYS=90
EXEMPLAR_TOP_K=3

# Cost Accounting Calibration (USD per 1,000 tokens)
COST_CHEAP_INPUT=0.00015
COST_CHEAP_OUTPUT=0.00060
COST_STRONG_INPUT=0.00180
COST_STRONG_OUTPUT=0.00540
COST_CACHE_READ=0.00003
COST_CACHE_WRITE=0.00015
BUDGET_ALERT=50.0
